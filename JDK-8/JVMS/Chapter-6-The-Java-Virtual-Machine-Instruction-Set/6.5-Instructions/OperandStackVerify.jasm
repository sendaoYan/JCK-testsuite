// JVMS 6.5 / 4.10: the verifier must reject instructions whose operand-stack
// types, depth, or exit stack do not match the instruction's contract.  Each
// class below has exactly one bad method; OperandStackVerifyTest loads each
// and asserts a VerifyError.  This complements the single-case
// TypeMismatchVerify by covering type mismatch, stack underflow and stack
// overflow across the arithmetic / compare / conversion / branch / array /
// return / stack families.

super public class IaddLongOperand
    version 52:0
{
    public Method "<init>":"()V"
        stack 1 locals 1
    {
        aload_0;
        invokespecial Method java/lang/Object."<init>":"()V";
        return;
    }
    // iadd expects two ints; the top of stack is a long.
    public static Method bad:"(J)I"
        stack 2 locals 2
    {
        lload_0;
        iadd;
        ireturn;
    }
}

