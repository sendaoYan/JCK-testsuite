// JVMS 6.5 per-opcode comparison boundary matrix: fcmpl/fcmpg/dcmpl/dcmpg with
// NaN in the SECOND operand (JVMS 6.5 says "if either value is NaN"), signed
// zero (which fcmp/dcmp treat as equal, unlike Float.compare/Double.compare),
// and lcmp at the long extremes.

super public class CmpNanOps
    version 71:0
{
    public Method "<init>":"()V"
        stack 1 locals 1
    {
        aload_0;
        invokespecial Method java/lang/Object."<init>":"()V";
        return;
    }

    public static Method fcmplNan2:"(FF)I"
        stack 2 locals 2
    {
        fload_0;
        fload_1;
        fcmpl;
        ireturn;
    }

    public static Method fcmpgNan2:"(FF)I"
        stack 2 locals 2
    {
        fload_0;
        fload_1;
        fcmpg;
        ireturn;
    }

    public static Method dcmplNan2:"(DD)I"
        stack 4 locals 4
    {
        dload_0;
        dload_2;
        dcmpl;
        ireturn;
    }

    public static Method dcmpgNan2:"(DD)I"
        stack 4 locals 4
    {
        dload_0;
        dload_2;
        dcmpg;
        ireturn;
    }

    // fcmpl(-0.0f, +0.0f) -> 0
    public static Method fcmplZero:"()I"
        stack 2 locals 0
    {
        fconst_0;
        fconst_0;
        fneg;
        fcmpl;
        ireturn;
    }

    // dcmpg(-0.0, +0.0) -> 0
    public static Method dcmpgZero:"()I"
        stack 4 locals 0
    {
        dconst_0;
        dconst_0;
        dneg;
        dcmpg;
        ireturn;
    }

    // lcmp(Long.MIN_VALUE, Long.MAX_VALUE) -> -1 (MIN computed as MAX+1 wrap)
    public static Method lcmpMinMax:"()I"
        stack 4 locals 0
    {
        ldc2_w long 9223372036854775807l;
        lconst_1;
        ladd;
        ldc2_w long 9223372036854775807l;
        lcmp;
        ireturn;
    }

    // lcmp(Long.MAX_VALUE, Long.MIN_VALUE) -> +1
    public static Method lcmpMaxMin:"()I"
        stack 6 locals 0
    {
        ldc2_w long 9223372036854775807l;
        ldc2_w long 9223372036854775807l;
        lconst_1;
        ladd;
        lcmp;
        ireturn;
    }
}
