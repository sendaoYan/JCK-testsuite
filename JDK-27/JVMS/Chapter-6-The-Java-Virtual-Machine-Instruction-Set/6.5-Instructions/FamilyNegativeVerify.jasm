// JVMS 6.5 / 4.10: negative coverage for the instruction families that
// OperandStackVerify does not already exercise.  Each class below carries one
// deliberate operand-stack type error or depth error in a single method;
// FamilyNegativeVerifyTest loads each and asserts a VerifyError.  Families:
//   load-store   IloadOnLongLocal / LstoreIntoInt
//   conversion   D2iOnLong
//   comparison   FcmplOnLong / DcmpgUnderflow
//   cond-branch  IfAcmpeqOnInt
//   switch       TableswitchUnderflow / LookupswitchOnLong
//   array        IastoreOnLongArray / ArraylengthOnInt / NewarrayLongCount
//   invoke       InvokestaticWrongArg
//   return       LreturnOnInt / AreturnOnInt
//   stack        SwapUnderflow / Dup2Underflow
//   monitor      MonitorenterOnInt
//   field        PutfieldWrongType / GetfieldOnInt

super public class IloadOnLongLocal
    version 71:0
{
    public Method "<init>":"()V"
        stack 1 locals 1
    {
        aload_0;
        invokespecial Method java/lang/Object."<init>":"()V";
        return;
    }
    // iload expects an int local; local 0 is a long.
    public static Method bad:"(J)I"
        stack 1 locals 2
    {
        iload_0;
        ireturn;
    }
}

