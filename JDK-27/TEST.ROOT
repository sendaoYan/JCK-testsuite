# This file identifies the root of the test-suite hierarchy.
# JCK-testsuite: conformance tests derived from the Java Language
# Specification (JLS) and the Java Virtual Machine Specification (JVMS),
# Java SE 27 edition.

keys=intermittent randomness needs-src

# Minimum jtreg version
requiredVersion=7+1

# Path to libraries in the topmost test directory.
external.lib.roots = ../
